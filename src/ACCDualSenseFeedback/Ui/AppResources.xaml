<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:ACCDualSenseFeedback.Ui"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <Color x:Key="Color.Window">#FFF7F8F9</Color>
    <Color x:Key="Color.Canvas">#FFF0F2F4</Color>
    <Color x:Key="Color.Surface">#FFE1E5E8</Color>
    <Color x:Key="Color.SurfaceHover">#FFD7DCE0</Color>
    <Color x:Key="Color.Border">#FFD2D7DB</Color>
    <Color x:Key="Color.BorderStrong">#FFB7BEC5</Color>
    <Color x:Key="Color.TextPrimary">#FF0A0B0D</Color>
    <Color x:Key="Color.TextSecondary">#FF59626B</Color>
    <x:Static x:Key="Color.TextTertiary" Member="ui:UiTypography.CaptionColor" />
    <Color x:Key="Color.Brand">#FFE32232</Color>
    <Color x:Key="Color.BrandHover">#FFCA1828</Color>
    <Color x:Key="Color.Success">#FF51D486</Color>
    <Color x:Key="Color.Warning">#FFE0A23F</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="Brush.BrandHover" Color="{StaticResource Color.BrandHover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

    <x:Static x:Key="Font.Text" Member="ui:UiTypography.TextFont" />
    <x:Static x:Key="Font.Display" Member="ui:UiTypography.DisplayFont" />
    <x:Static x:Key="Font.Latin" Member="ui:UiTypography.LatinFont" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="{x:Static ui:UiTypography.RenderingMode}" />
    </Style>

    <Style x:Key="Type.StatusStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.StatusSize}" />
        <Setter Property="FontWeight" Value="{x:Static ui:UiTypography.StatusWeight}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Type.StatusDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.StatusSize}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Type.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.SectionLabelSize}" />
        <Setter Property="FontWeight" Value="{x:Static ui:UiTypography.SectionLabelWeight}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Type.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.DisplaySize}" />
        <Setter Property="FontWeight" Value="{x:Static ui:UiTypography.DisplayWeight}" />
        <Setter Property="LineHeight" Value="{x:Static ui:UiTypography.DisplayLineHeight}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.BodySize}" />
        <Setter Property="LineHeight" Value="{x:Static ui:UiTypography.BodyLineHeight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.CaptionSize}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
    </Style>

    <Style x:Key="Type.ParameterReadout" TargetType="TextBlock" BasedOn="{StaticResource Type.Caption}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Latin}" />
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.ValueSize}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style
        x:Key="Type.PageTitle"
        TargetType="TextBlock"
        BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{x:Static ui:UiTypography.PageTitleSize}" />
        <Setter Property="FontWeight" Value="{x:Static ui:UiTypography.PageTitleWeight}" />
        <Setter Property="LineHeight" Value="{x:Static ui:UiTypography.PageTitleLineHeight}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
    </Style>

    <Style x:Key="Button.Caption" TargetType="Button">
        <Setter Property="Width" Value="41" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Brand}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Segment" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonScale" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="7" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverSurface" Property="Background" Value="#12000000" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HoverSurface" Property="Background" Value="#10000000" /></Trigger>
                        <EventTrigger RoutedEvent="PreviewMouseDown"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.975" Duration="0:0:0.07" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.975" Duration="0:0:0.07" />
                        </Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseUp"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Navigation" TargetType="Button">
        <Setter Property="Height" Value="43" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Opacity" Value="0.82" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonScale" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <ContentPresenter
                            x:Name="ContentMotion"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center">
                            <ContentPresenter.RenderTransform><TranslateTransform /></ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="Tag" Value="Active"><Setter Property="Opacity" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ContentMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ContentMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.17"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseDown"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.07" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.07" />
                        </Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseUp"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Inline" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="#12000000" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1F000000" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Decrease" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Brush.Brand}" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Increase" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Brush.BorderStrong}" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid x:Name="ThumbMotion" Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseDown"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp"><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></EventTrigger>
                        </Grid.Triggers>
                        <Ellipse x:Name="Halo" Fill="#18E32232" Opacity="0" />
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Brush.TextPrimary}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Feel" TargetType="Slider">
        <Setter Property="Height" Value="44" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="50" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="44" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Decrease}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Increase}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Compact" TargetType="Slider" BasedOn="{StaticResource Slider.Feel}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="{x:Static ui:UiTypography.SliderMargin}" />
    </Style>

    <Style x:Key="ScrollBar.ModuleButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.ModuleThumb" TargetType="Thumb">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Surface" Width="4" Background="#66A3ABB3" CornerRadius="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A6757E87" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.TextSecondary}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Module" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="8" Background="Transparent">
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="True"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Value="{TemplateBinding Value}"
                            ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBar.ModuleButton}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollBar.ModuleThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBar.ModuleButton}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
