<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <AssemblyName>ACCDualSenseFeedback</AssemblyName>
    <RootNamespace>ACCDualSenseFeedback</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>ACC DualSense Feedback</AssemblyTitle>
    <Product>ACC DualSense Feedback</Product>
    <Description>Low-latency DualSense feedback for Assetto Corsa Competizione.</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>ACCDualSenseFeedback.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-mark.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\PORTABLE-README.txt" Link="README.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\FORZA-DUALSENSE-LICENSE.txt" Link="licenses\FORZA-DUALSENSE-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\VIGEM-NET-LICENSE.txt" Link="licenses\VIGEM-NET-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
